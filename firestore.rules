rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }
    // 2. Global Helpers
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isAdmin() {
      return isSignedIn() && (
        (request.auth.token.email != null && (
          request.auth.token.email.lower() == 'isadora.mlima@ufpe.br' || 
          request.auth.token.email.lower() == 'isadora.mlima@ufpe' ||
          request.auth.token.email.lower().matches('^isadora\\.mlima@ufpe.*') ||
          request.auth.token.email.lower() == 'isadorasdml@gmail.com'
        )) || 
        (request.auth.token.email != null && (exists(/databases/$(database)/documents/admins/$(request.auth.token.email)) || exists(/databases/$(database)/documents/admins/$(request.auth.token.email.lower()))))
      );
    }

    function isRHorSuperAdmin() {
      return isSignedIn() && (
        isAdmin() ||
        (request.auth.token.email != null && (
          request.auth.token.email.lower() == 'isadora.mlima@ufpe.br' || 
          request.auth.token.email.lower() == 'isadora.mlima@ufpe' ||
          request.auth.token.email.lower().matches('^isadora\\.mlima@ufpe.*') ||
          request.auth.token.email.lower() == 'isadorasdml@gmail.com'
        )) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isRH == true ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isDiretorio == true ||
          (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.leagueRole != null &&
           get(/databases/$(database)/documents/users/$(request.auth.uid)).data.leagueRole.matches('.*(RH|Recursos Humanos|Diretoria|Diretório|Diretoria).*'))
        ))
      );
    }

    function incoming() {
      return request.resource.data;
    }
    
    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // 3. Validation Blueprint for Response
    function isValidResponse(data) {
      return data.keys().hasAll(['userId', 'email', 'name', 'course', 'leagueRole', 'status'])
        && data.userId is string
        && data.email is string && data.email.size() <= 255
        && data.name is string && data.name.size() <= 255
        && (!data.keys().hasAny(['birthday']) || (data.birthday is string && data.birthday.size() <= 50))
        && data.course is string && data.course.size() <= 255
        && data.period is string && data.period.size() <= 50
        && (!data.keys().hasAny(['collegeFocus']) || data.collegeFocus is number)
        && data.leagueRole is string && data.leagueRole.size() <= 255
        && (!data.keys().hasAny(['leagueFocus']) || data.leagueFocus is number)
        && (!data.keys().hasAny(['weeklyHours']) || (data.weeklyHours is string && data.weeklyHours.size() <= 200))
        && (!data.keys().hasAny(['roleFocus']) || (data.roleFocus is string && data.roleFocus.size() <= 2000))
        && (!data.keys().hasAny(['learningFocus']) || (data.learningFocus is string && data.learningFocus.size() <= 2000))
        && (!data.keys().hasAny(['currentProjects']) || (data.currentProjects is string && data.currentProjects.size() <= 1000))
        && (!data.keys().hasAny(['interestedProjects']) || (data.interestedProjects is string && data.interestedProjects.size() <= 1000))
        && (!data.keys().hasAny(['priority']) || (data.priority is string && data.priority.size() <= 50))
        && (!data.keys().hasAny(['progress']) || data.progress is number)
        && (!data.keys().hasAny(['deadline']) || (data.deadline is string && data.deadline.size() <= 50))
        && (!data.keys().hasAny(['notifications']) || data.notifications is bool)
        && (!data.keys().hasAny(['createdAt']) || data.createdAt is number)
        && data.status in ['Ativo', 'Ex-membro']
        && (!data.keys().hasAny(['deletionReason']) || (data.deletionReason is string && data.deletionReason.size() <= 2000))
        && (!data.keys().hasAny(['discordUser']) || (data.discordUser is string && data.discordUser.size() <= 100))
        && (!data.keys().hasAny(['isInProject']) || (data.isInProject is string && data.isInProject.size() <= 50))
        && (!data.keys().hasAny(['notInProjectStatus']) || (data.notInProjectStatus is string && data.notInProjectStatus.size() <= 200))
        && (!data.keys().hasAny(['attendancePreference']) || (data.attendancePreference is string && data.attendancePreference.size() <= 100))
        && (!data.keys().hasAny(['microtasksInterest']) || (data.microtasksInterest is string && data.microtasksInterest.size() <= 100))
        && (!data.keys().hasAny(['editAuthorized']) || data.editAuthorized is bool)
        && (!data.keys().hasAny(['editRequestStatus']) || data.editRequestStatus is string || data.editRequestStatus == null)
        && (!data.keys().hasAny(['editHistory']) || data.editHistory is list)
        && (!data.keys().hasAny(['lastEditedAt']) || data.lastEditedAt is number || data.lastEditedAt == null)
        && (!data.keys().hasAny(['lastEditedBy']) || (data.lastEditedBy is string && data.lastEditedBy.size() <= 255));
    }

    function isValidEvent(data) {
      return data.keys().hasAll(['userId', 'title', 'description', 'duration', 'date', 'createdAt'])
        && data.userId is string
        && data.title is string && data.title.size() <= 255
        && data.description is string && data.description.size() <= 2000
        && data.duration is string && data.duration.size() <= 100
        && data.date is string && data.date.size() <= 50
        && data.createdAt is number;
    }

    function isValidUser(data) {
      return (!data.keys().hasAny(['hasReceivedWelcomeEmail']) || data.hasReceivedWelcomeEmail is bool)
        && (!data.keys().hasAny(['lastEmailSentAt']) || data.lastEmailSentAt is number)
        && (!data.keys().hasAny(['lastEventEndDate']) || data.lastEventEndDate is number)
        && (!data.keys().hasAny(['theme']) || data.theme in ['light', 'dark'])
        && (!data.keys().hasAny(['isRH']) || data.isRH is bool)
        && (!data.keys().hasAny(['isDiretorio']) || data.isDiretorio is bool)
        && (!data.keys().hasAny(['leagueRole']) || (data.leagueRole is string && data.leagueRole.size() <= 255));
    }

    function isValidAdmin(data) {
       return data.keys().hasAll(['email'])
         && data.email is string && data.email.size() <= 255;
    }

    function isValidAuditLog(data) {
      return data.keys().hasAll(['performedByEmail', 'action', 'targetMemberName', 'timestamp'])
        && data.performedByEmail is string && data.performedByEmail.size() <= 255
        && (!data.keys().hasAny(['performedByName']) || (data.performedByName is string && data.performedByName.size() <= 255))
        && (!data.keys().hasAny(['performedByUid']) || (data.performedByUid is string && data.performedByUid.size() <= 128))
        && data.action is string && data.action.size() <= 100
        && (!data.keys().hasAny(['targetMemberId']) || (data.targetMemberId is string && data.targetMemberId.size() <= 128))
        && data.targetMemberName is string && data.targetMemberName.size() <= 255
        && (!data.keys().hasAny(['targetMemberEmail']) || (data.targetMemberEmail is string && data.targetMemberEmail.size() <= 255))
        && (!data.keys().hasAny(['details']) || (data.details is string && data.details.size() <= 4000))
        && (!data.keys().hasAny(['previousValue']) || (data.previousValue is string && data.previousValue.size() <= 4000))
        && (!data.keys().hasAny(['newValue']) || (data.newValue is string && data.newValue.size() <= 4000))
        && data.timestamp is number;
    }

    function isValidProject(data) {
      return data.keys().hasAll(['name', 'status', 'engine', 'leader', 'createdAt'])
        && data.name is string && data.name.size() <= 255
        && data.status is string && data.status.size() <= 50
        && data.engine is string && data.engine.size() <= 100
        && data.leader is string && data.leader.size() <= 255
        && data.createdAt is number;
    }

    function isValidOpening(data) {
      return data.keys().hasAll(['role', 'projectId', 'projectName', 'description', 'status', 'openedAt'])
        && data.role is string && data.role.size() <= 255
        && data.projectId is string && data.projectId.size() <= 128
        && data.projectName is string && data.projectName.size() <= 255
        && data.description is string && data.description.size() <= 2000
        && data.status is string && data.status.size() <= 50
        && data.openedAt is number;
    }

    function isValidTask(data) {
      return data.keys().hasAll(['title', 'projectName', 'area', 'deliverySpecs', 'status', 'createdAt'])
        && data.title is string && data.title.size() <= 255
        && data.projectName is string && data.projectName.size() <= 255
        && data.area is string && data.area.size() <= 100
        && data.deliverySpecs is string && data.deliverySpecs.size() <= 2000
        && data.status is string && data.status.size() <= 50
        && data.createdAt is number;
    }

    function isValidProposal(data) {
      return data.keys().hasAll(['proposerName', 'proposerEmail', 'projectTitle', 'oneSentencePitch', 'status', 'createdAt'])
        && data.proposerName is string && data.proposerName.size() <= 255
        && data.proposerEmail is string && data.proposerEmail.size() <= 255
        && data.projectTitle is string && data.projectTitle.size() <= 255
        && data.oneSentencePitch is string && data.oneSentencePitch.size() <= 1000
        && data.status is string && data.status.size() <= 100
        && data.createdAt is number;
    }

    function isValidDoubt(data) {
      return data.keys().hasAll(['userId', 'authorName', 'authorEmail', 'title', 'description', 'status', 'createdAt'])
        && data.userId is string && data.userId.size() <= 128
        && data.authorName is string && data.authorName.size() <= 255
        && data.authorEmail is string && data.authorEmail.size() <= 255
        && (!data.keys().hasAny(['authorDiscord']) || (data.authorDiscord is string && data.authorDiscord.size() <= 100))
        && (!data.keys().hasAny(['authorRole']) || (data.authorRole is string && data.authorRole.size() <= 255))
        && (!data.keys().hasAny(['category']) || (data.category is string && data.category.size() <= 100))
        && data.title is string && data.title.size() <= 300
        && data.description is string && data.description.size() <= 5000
        && (!data.keys().hasAny(['priority']) || (data.priority is string && data.priority.size() <= 50))
        && data.status in ['pendente', 'em_analise', 'respondida']
        && (!data.keys().hasAny(['response']) || (data.response is string && data.response.size() <= 5000))
        && (!data.keys().hasAny(['answeredBy']) || (data.answeredBy is string && data.answeredBy.size() <= 255))
        && (!data.keys().hasAny(['answeredByRole']) || (data.answeredByRole is string && data.answeredByRole.size() <= 100))
        && (!data.keys().hasAny(['answeredAt']) || data.answeredAt is number)
        && data.createdAt is number;
    }

    // 4. Match Blocks
    match /responses/{responseId} {
      allow read: if isSignedIn();
      
      allow create: if isSignedIn()
        && isValidId(responseId)
        && (isRHorSuperAdmin() || incoming().userId == request.auth.uid)
        && isValidResponse(incoming());
        
      allow update: if isSignedIn()
        && (isRHorSuperAdmin() || (incoming().userId == existing().userId && existing().userId == request.auth.uid))
        && isValidResponse(incoming());
        
      allow delete: if isRHorSuperAdmin();
    }

    match /events/{eventId} {
      allow read: if isSignedIn(); // All authenticated users can view the calendar
      
      allow create: if isAdmin()
        && isValidId(eventId)
        && incoming().userId == request.auth.uid
        && isValidEvent(incoming());

      allow update: if isAdmin()
        && isValidEvent(incoming());
        
      allow delete: if isAdmin();
    }

    match /users/{userId} {
      allow read: if isSignedIn() && userId == request.auth.uid;
      
      allow create: if isSignedIn()
        && userId == request.auth.uid
        && isValidUser(incoming());
        
      allow update: if isSignedIn()
        && userId == request.auth.uid
        && isValidUser(incoming());
    }

    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /audit_logs/{logId} {
      allow read: if isAdmin();
      allow create: if isSignedIn()
        && isValidId(logId)
        && isValidAuditLog(incoming());
      allow update: if false;
      allow delete: if isSignedIn() && request.auth.token.email != null && (
        request.auth.token.email.lower() == 'isadora.mlima@ufpe.br'
      );
    }

    match /projects/{projectId} {
      allow read: if isSignedIn();
      allow create: if isRHorSuperAdmin()
        && isValidId(projectId)
        && isValidProject(incoming());
      allow update: if isRHorSuperAdmin()
        && isValidProject(incoming());
      allow delete: if isRHorSuperAdmin();
    }

    match /openings/{openingId} {
      allow read: if isSignedIn();
      allow create: if isAdmin()
        && isValidId(openingId)
        && isValidOpening(incoming());
      allow update: if isAdmin()
        && isValidOpening(incoming());
      allow delete: if isAdmin();
    }

    match /tasks/{taskId} {
      allow read: if isSignedIn();
      allow create: if isAdmin()
        && isValidId(taskId)
        && isValidTask(incoming());
      allow update: if isSignedIn()
        && isValidTask(incoming());
      allow delete: if isAdmin();
    }

    match /proposals/{proposalId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.proposerEmail == request.auth.token.email);
      allow create: if isSignedIn()
        && isValidId(proposalId)
        && isValidProposal(incoming());
      allow update: if isAdmin()
        && isValidProposal(incoming());
      allow delete: if isAdmin();
    }

    match /doubts/{doubtId} {
      // Dúvidas de outros membros NÃO ficam públicas para membros comuns;
      // Membros comuns só leem as suas próprias; Super Admin e Membros do Diretório leem todas.
      allow read: if isSignedIn() && (isRHorSuperAdmin() || resource.data.userId == request.auth.uid);
      
      allow create: if isSignedIn()
        && isValidId(doubtId)
        && incoming().userId == request.auth.uid
        && isValidDoubt(incoming());
        
      allow update: if isSignedIn()
        && (isRHorSuperAdmin() || (existing().userId == request.auth.uid && existing().status == 'pendente'))
        && isValidDoubt(incoming());
        
      allow delete: if isSignedIn() && (isRHorSuperAdmin() || existing().userId == request.auth.uid);
    }
  }
}
